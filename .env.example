# TaxTracker — live-test credentials TEMPLATE (safe to commit; contains no real secrets)
#
# To run the live credential tests, copy this file to `.env.test.local` (which is
# gitignored) and fill in real values. NEVER paste real secrets into chat or commit them.
#
#   cp .env.example .env.test.local
#   # then edit .env.test.local
#
# The GitHub PAT must be FINE-GRAINED, scoped to ONLY the taxtracker-data repo,
# Contents: Read and Write, with a short (e.g. 7-day) expiry. Revoke it after testing.
# The Claude API key should be a fresh key you can rotate/delete after testing.
# These are the SAME two secrets the app asks the user to type into the browser.

# Fine-grained GitHub Personal Access Token (repo: SpitefulGrain40/taxtracker-data, Contents RW)
TAXTRACKER_GITHUB_PAT=

# Anthropic Claude API key (console.anthropic.com — NOT a Claude Pro/Code login token)
TAXTRACKER_CLAUDE_KEY=

# The private data repo the PAT is scoped to
TAXTRACKER_DATA_REPO=SpitefulGrain40/taxtracker-data
